{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ctm-creator-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./private",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://www.youtube.com/@ctmtvlr"
  }
}
